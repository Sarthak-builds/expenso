# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
#
# WARNING: every EXPO_PUBLIC_* value is INLINED into the JavaScript bundle at
# build time. It is trivially extractable from any distributed build. Nothing
# here is a secret. See docs/adr/0004-credentials-and-secrets.md
#
# Editing this file does NOT hot-reload — it is a Babel transform.
# Restart with `pnpm start --clear` after any change.

# --- Gemini -----------------------------------------------------------------
# Default key, overridable per-user in Settings (stored in MMKV).
# Restrict this key in AI Studio to the app's Android signature + a low quota.
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# --- Device lock (NOT authentication) ---------------------------------------
# The two phone numbers permitted to unlock the app.
EXPO_PUBLIC_USER_A_PHONE=0000000000
EXPO_PUBLIC_USER_B_PHONE=1111111111

# SHA-256 hex digest of the shared 4-digit PIN.
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('1234').digest('hex'))"
EXPO_PUBLIC_PIN_HASH=03ac674216f3e15c761ee1a5e255f067953623c8b388b4459e13f978d7c846f4
