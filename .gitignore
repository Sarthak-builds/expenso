# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files — NEVER commit real values. This repo is PUBLIC.
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time and are
# extractable from any distributed build. See docs/adr/0004-credentials-and-secrets.md
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local bundle smoke-test output
.expo-export-test/

# gstack — installed per-machine, deliberately NOT committed.
#
# 57 MB and 59 skills, most of them irrelevant here (iOS, Supabase, deploy,
# browser automation). Committing it would put that in PUBLIC git history
# permanently, since history cannot be trimmed without a force-push rewrite.
# Its install-time scan also came back Gen "High Risk" / Socket 74 alerts,
# which is not something to vendor into a repo under your name by default.
#
# Install it per-machine instead:  pnpm dlx skills add garrytan/gstack
# Most of its skills also need Bun, which this project does not otherwise use.
.agents/skills/gstack/
.claude/skills/gstack/
