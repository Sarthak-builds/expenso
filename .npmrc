# React Native autolinking cannot follow pnpm's default symlinked node_modules.
# Gradle/CocoaPods resolve native module paths on disk, so a hoisted layout is
# required. Do not remove — builds will fail with "module not found" at link time.
# See docs/adr/0009-package-manager-pnpm.md
node-linker=hoisted

# Expo/RN packages frequently declare loose or missing peer ranges.
strict-peer-dependencies=false
